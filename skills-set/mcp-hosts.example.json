{
  "_comment": "Copy the seo-decision block into Cursor/Claude/Codex MCP config. Replace ROOT with this plugin folder path.",
  "mcpServers": {
    "seo-decision": {
      "command": "python",
      "args": ["ROOT/mcp/decision_server.py"],
      "env": {
        "SEO_TEACHER_ROOT": "ROOT"
      }
    },
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server@latest"],
      "env": {
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}",
        "ENABLED_MODULES": "SERP,KEYWORDS_DATA,DATAFORSEO_LABS,ONPAGE,BACKLINKS,DOMAIN_ANALYTICS,BUSINESS_DATA"
      }
    }
  }
}
